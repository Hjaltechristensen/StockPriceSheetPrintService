{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Saxo": {
    "AppKey": "${SAXO_APP_KEY}",
    "AppSecret": "${SAXO_APP_SECRET}",
    "RedirectUrl": "${SAXO_REDIRECT_URL}",
    "AuthEndpoint": "https://live.logonvalidation.net/authorize",
    "TokenEndpoint": "https://live.logonvalidation.net/token",
    "ApiBaseUrl": "https://gateway.saxobank.com/sim/openapi"
  },
  "StockApi": {
    "ApiKey": "${STOCK_API_KEY}"
  },
  "SheetsApi": {
    "SheetsKey": "${SHEETS_KEY}",
    "CredentialsPath": "${GOOGLE_CREDENTIALS_PATH}"
  }
}
